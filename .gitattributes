# Normalize text files to LF in the repository; Git converts on checkout per core.autocrlf.
* text=auto

# Windows-only scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.gfo binary
