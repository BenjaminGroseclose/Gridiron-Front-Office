<Project>
  <!--
    Central Package Management: every package version lives here.
    Before adding a package, check its license and add a row to THIRD_PARTY_NOTICES.md (D-011).
    Stay on .NET 10 LTS packages (D-002); don't take 11.0 previews.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzers applied to every project (build-time only, never shipped). -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
  </ItemGroup>

  <!-- Host and UI -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.1" />
  </ItemGroup>

  <!-- Data access (D-024) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <!-- Logging (D-007) -->
  <ItemGroup>
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>

  <!-- Tests (D-018) -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
