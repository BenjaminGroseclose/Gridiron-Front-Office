<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Spike S0a (M0 WP2): a throwaway proof that EF Core + the GFO unit-of-work rules hold up
    (DATA_ACCESS_OPTIONS.md §5). Deleted once its results are recorded in D-024 (D-066).
    Run it in Release from the repo root: dotnet run -c Release (with project spikes/S0a.EfProof).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Stands in for Infrastructure, so it may open SQLite connections for its probes (Directory.Build.props). -->
    <_GfoMayOpenSqlite>true</_GfoMayOpenSqlite>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
