@implements IDisposable
@inject ISettingsStore Settings
@inject GfoThemeService Theme
@* Applies Settings → Appearance once the page is up, and again whenever the settings change (UI_DESIGN_SYSTEM.md §3.2).
   Renders nothing. *@

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Settings.Changed += OnSettingsChanged;
            await ApplyAsync(Settings.Current);
        }
    }

    // Saves complete off the UI thread, so the re-apply is marshalled back onto it.
    private void OnSettingsChanged(object? sender, AppSettings settings) => _ = InvokeAsync(() => ApplyAsync(settings));

    private Task ApplyAsync(AppSettings settings) => Theme.ApplyAsync(AppearanceMapping.From(settings.Appearance, teamPrimary: null));

    public void Dispose() => Settings.Changed -= OnSettingsChanged;
}
