@inherits LayoutComponentBase
@* The layout both hosts use: the AppShell around the routed page. The main menu and league navigation arrive in M0 WP9. *@
<AppearanceSync />

<AppShell>
    <Navigation>
        <MainNav />
    </Navigation>
    <ChildContent>
        <PageErrorBoundary>
            @Body
        </PageErrorBoundary>
    </ChildContent>
</AppShell>

@* Forwards JavaScript errors to the log (the host page loads gfo-diagnostics.js before Blazor). *@
<ClientDiagnostics />

@* Fluent UI v5 hosts the dialog, drawer, toast and tooltip providers here (shared by both hosts). *@
<FluentProviders />
