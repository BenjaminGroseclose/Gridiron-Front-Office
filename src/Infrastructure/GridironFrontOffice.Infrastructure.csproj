<Project Sdk="Microsoft.NET.Sdk">
  <!--
    EF Core + SQLite (LeagueDbContext, migrations, SaveWriter/SaveReader, SaveManager, snapshots),
    logging bootstrap, AppPaths and the settings store (ARCHITECTURE.md §4.2, DATA_ACCESS_GUIDE.md §3).
    The ONLY project allowed to open SQLite connections or own transactions.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Application\GridironFrontOffice.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Design-time only: `dotnet ef migrations add`. Never shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.Debug" />
  </ItemGroup>
  <ItemGroup>
    <!-- The torture tests reach the internals (LeagueDbContext, TypedIDs, SqliteFile). -->
    <InternalsVisibleTo Include="GridironFrontOffice.Infrastructure.Tests" />
    <!-- The generator tests build the shipped seed data (EmbeddedSeedData). -->
    <InternalsVisibleTo Include="GridironFrontOffice.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\data\league\teams.json" LogicalName="league/teams.json" />
    <EmbeddedResource Include="..\..\data\league\colleges.json" LogicalName="league/colleges.json" />
    <!-- Player data (M1 WP3). The name files are the largest and load only when a league is generated. -->
    <EmbeddedResource Include="..\..\data\players\positions.json" LogicalName="players/positions.json" />
    <EmbeddedResource Include="..\..\data\players\generation.json" LogicalName="players/generation.json" />
    <EmbeddedResource Include="..\..\data\players\jersey-rules.json" LogicalName="players/jersey-rules.json" />
    <EmbeddedResource Include="..\..\data\names\first.json" LogicalName="names/first.json" />
    <EmbeddedResource Include="..\..\data\names\last.json" LogicalName="names/last.json" />
    <EmbeddedResource Include="..\..\data\places\hometowns.json" LogicalName="places/hometowns.json" />
    <EmbeddedResource Include="..\..\data\blocklists\famous-people.json" LogicalName="blocklists/famous-people.json" />
    <EmbeddedResource Include="..\..\data\contracts\contracts.json" LogicalName="contracts/contracts.json" />
  </ItemGroup>
</Project>
