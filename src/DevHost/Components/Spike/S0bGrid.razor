@page "/_spike/s0b/grid"
@inject IJSRuntime JS
@* Spike S0b: FluentDataGrid with 2,000 rows — virtualized + pinned first column + sticky header + compact rows +
   Razor cell templates + keyboard, all at once (UI_DESIGN_SYSTEM.md §5.3 P0 checklist). *@

<PageTitle>S0b · Grid</PageTitle>
<SpikeThemeBar />

<section class="spike-page">
    <h1 class="spike-display">Grid · 2,000 players</h1>
    <div class="spike-row">
        <label>
            Row size
            <select @bind="_rowSizeName" @bind:after="OnRowSizeChangedAsync" data-testid="row-size">
                @foreach (var size in Enum.GetNames<DataGridRowSize>())
                {
                    <option value="@size">@size</option>
                }
            </select>
        </label>
        <label>
            ItemSize (px)
            <input type="number" @bind="_itemSize" @bind:after="MeasureAsync" style="width:5em" data-testid="item-size" />
        </label>
        <FluentCheckbox Label="Resizable" @bind-Value="_resizable" data-testid="resizable" />
        <FluentCheckbox Label="Header menu" @bind-Value="_headerMenu" data-testid="header-menu" />
        <FluentCheckbox Label="Compact header" @bind-Value="_compactHeader" data-testid="compact-header" />
        <span class="spike-muted" data-testid="row-metrics">ItemSize @_itemSize px · measured row height @_measured px</span>
    </div>

    <div class="spike-grid-frame gfo-grid" data-testid="grid-frame">
        <FluentDataGrid @ref="_grid" TGridItem="SpikePlayer" Items="@_items" Virtualize="true" ItemSize="@_itemSize" RowSize="@_rowSize"
                        GenerateHeader="DataGridGeneratedHeaderType.Sticky" ResizableColumns="@_resizable" HeaderCellAsButtonWithMenu="@_headerMenu" ShowHover="true"
                        SortMode="DataGridSortMode.Multiple">
            <PropertyColumn HeaderCellItemTemplate="@Header" Property="@(p => p.Name)" Title="Player" Pin="DataGridColumnPin.Start" Width="200px" MinWidth="200px" Sortable="true" />
            <PropertyColumn HeaderCellItemTemplate="@Header" Property="@(p => p.Position)" Title="Pos" Width="72px" MinWidth="72px" Sortable="true" />
            <PropertyColumn HeaderCellItemTemplate="@Header" Property="@(p => p.Team)" Title="Team" Width="72px" MinWidth="72px" Sortable="true" />
            <PropertyColumn HeaderCellItemTemplate="@Header" Property="@(p => p.Age)" Title="Age" Width="64px" MinWidth="64px" Sortable="true" Align="DataGridCellAlignment.End" />
            <TemplateColumn HeaderCellItemTemplate="@Header" Title="OVR" Width="130px" MinWidth="130px" SortBy="@ByOverall">
                <span class="spike-chip" data-tier="@SpikeData.Tier(context.Overall)">@context.Overall</span><span class="spike-range">@context.OverallLow–@context.OverallHigh</span>
            </TemplateColumn>
            <PropertyColumn HeaderCellItemTemplate="@Header" Property="@(p => p.Potential)" Title="POT" Width="64px" MinWidth="64px" Sortable="true" />
            <TemplateColumn HeaderCellItemTemplate="@Header" Title="Cap hit" Width="100px" MinWidth="100px" SortBy="@ByCapHit" Align="DataGridCellAlignment.End">
                <span class="spike-num">@SpikeData.Money(context.CapHit)</span>
            </TemplateColumn>
            @for (var i = 0; i < SpikeData.AttributeNames.Count; i++)
            {
                var index = i;
                <TemplateColumn HeaderCellItemTemplate="@Header" Title="@SpikeData.AttributeNames[index]" Width="64px" MinWidth="64px" Align="DataGridCellAlignment.End"
                                SortBy="@(GridSort<SpikePlayer>.ByAscending(p => p.Attributes[index]))">
                    <span class="spike-num">@context.Attributes[index]</span>
                </TemplateColumn>
            }
        </FluentDataGrid>
    </div>
</section>

@code {
    private static readonly GridSort<SpikePlayer> ByOverall = GridSort<SpikePlayer>.ByAscending(p => p.Overall);
    private static readonly GridSort<SpikePlayer> ByCapHit = GridSort<SpikePlayer>.ByAscending(p => p.CapHit);

    private readonly IQueryable<SpikePlayer> _items = SpikeData.Players.AsQueryable();
    private string _rowSizeName = nameof(DataGridRowSize.Small);
    private DataGridRowSize _rowSize = DataGridRowSize.Small;
    private float _itemSize = 36;
    private double _measured;
    private bool _resizable = true;
    private bool _headerMenu;
    private bool _compactHeader;
    private FluentDataGrid<SpikePlayer>? _grid;
    private (string? Title, bool Descending) _sort;

    // A GFO-owned header: one click sorts (descending first, GM-style), a second click flips. No Fluent internals touched.
    private RenderFragment<ColumnBase<SpikePlayer>>? Header => _compactHeader ? CompactHeader : null;

    private RenderFragment<ColumnBase<SpikePlayer>> CompactHeader => column =>
        @<button type="button" class="spike-th" data-sort="@(_sort.Title == column.Title ? (_sort.Descending ? "desc" : "asc") : null)"
                 @onclick="() => SortAsync(column)">@column.Title</button>;

    private async Task SortAsync(ColumnBase<SpikePlayer> column)
    {
        var descending = _sort.Title != column.Title || !_sort.Descending;
        _sort = (column.Title, descending);
        await _grid!.SortByColumnAsync(column, descending ? DataGridSortDirection.Descending : DataGridSortDirection.Ascending);
    }
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./spike.js");
            await MeasureAsync();
        }
    }

    private async Task OnRowSizeChangedAsync()
    {
        _rowSize = Enum.Parse<DataGridRowSize>(_rowSizeName);
        StateHasChanged();
        await Task.Yield();
        await MeasureAsync();
    }

    private async Task MeasureAsync()
    {
        if (_module is null)
        {
            return;
        }

        await Task.Delay(150);   // let the grid re-render first
        _measured = Math.Round(await _module.InvokeAsync<double>("rowHeight", "[data-testid=grid-frame]"), 1);
        StateHasChanged();
    }
}
