@page "/_spike/s0b/overlays"
@inject IDialogService Dialogs
@inject INotificationService Notifications
@* Spike S0b: the overlay pieces GFO wraps — drawer (peek sheet), dialog (confirm), toast. *@

<PageTitle>S0b · Overlays</PageTitle>
<SpikeThemeBar />

<section class="spike-page">
    <h1 class="spike-display">Overlays</h1>
    <div class="spike-row">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="PeekAsync" data-testid="open-drawer">Peek player (drawer)</FluentButton>
        <FluentButton OnClick="ConfirmAsync" data-testid="open-dialog">Release player (dialog)</FluentButton>
        <FluentButton OnClick="ToastAsync" data-testid="show-toast">Sign player (toast)</FluentButton>
    </div>
    <p class="spike-muted" data-testid="last-result">@_last</p>
</section>

@code {
    private string _last = "Nothing opened yet.";
    private bool _closeActionWasNull;

    private async Task PeekAsync()
    {
        await Dialogs.ShowDrawerAsync<SpikePeek>(options =>
        {
            options.Header.Title = "M. Okafor · EDGE";
            options.Alignment = DialogAlignment.End;
            options.Width = "440px";
            if (options.Header.CloseAction is { } close)
            {
                close.Visible = true;
            }

            _closeActionWasNull = options.Header.CloseAction is null;
            options.Parameters = new Dictionary<string, object?> { [nameof(SpikePeek.PlayerId)] = 7 };
        });
        _last = $"Drawer closed. CloseAction was null: {_closeActionWasNull}.";
    }

    private async Task ConfirmAsync()
    {
        var result = await Dialogs.ShowConfirmationAsync(
            "Release M. Okafor? His remaining bonus becomes $4.2M of dead money this season.",
            title: "Release player", primaryButton: "Release", secondaryButton: "Keep");
        _last = $"Dialog result: cancelled = {result.Cancelled}.";
    }

    private async Task ToastAsync()
    {
        await Notifications.ShowToastAsync(options =>
        {
            options.Intent = ToastIntent.Success;
            options.Title = "Signed R. Mensah";
            options.Message = "4 years · $38.0M · $14.0M guaranteed";
        });
        _last = "Toast shown.";
    }
}
