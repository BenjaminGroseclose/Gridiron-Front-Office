@using GridironFrontOffice.UI
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject SpikeOptions Options
@inject SpikeTheme Theme
@inject IJSRuntime JS
@* Spike S0c: the host page's root. A stand-in for the AppShell top bar (UI_DESIGN_SYSTEM.md §7) above the real AppRoot. *@

<div class="spike-shell">
    <header class="spike-topbar @(IsTitleBar ? "is-titlebar" : "")" data-drag-region>
        <span class="spike-crest">W</span>
        <span class="spike-team">Wolves</span>
        <span class="spike-meta">2027 · Week 7 · 4–2</span>
        <span class="spike-pill">Cap $12.4M</span>
        <span class="spike-grow"></span>
        <FluentTextInput Placeholder="Search…   Ctrl K" Class="spike-search" />
        <FluentButton Appearance="ButtonAppearance.Primary">Play Week 7</FluentButton>
        @if (IsTitleBar)
        {
            <span class="spike-caption-gap" aria-hidden="true"></span>
        }
    </header>
    <div class="spike-content">
        <AppRoot />
        <p class="spike-note">Title bar: <b>@Options.TitleBar</b> · prefers-color-scheme: <b>@(_systemDark is null ? "?" : _systemDark.Value ? "dark" : "light")</b> · scheme changes seen: <b>@_schemeChanges</b></p>
    </div>
</div>

@code {
    private DotNetObjectReference<SpikeRoot>? _self;
    private IJSObjectReference? _module;
    private bool? _systemDark;
    private int _schemeChanges;

    private bool IsTitleBar => Options.TitleBar == TitleBarMode.Html;

    /// <summary>Raised once the theme is applied and the page listeners are in place.</summary>
    public static event Action? Settled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        SpikeProbe.Mark("blazor-first-render");
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./spike.js");
        if (!Options.BootHide)
        {
            await _module.InvokeVoidAsync("reveal");   // show the page in Fluent's default theme, for comparison
        }

        await Theme.ApplyAsync(Options.Dark);
        await _module.InvokeVoidAsync("reveal");
        SpikeProbe.Mark("theme-applied");

        _self = DotNetObjectReference.Create(this);
        _systemDark = await _module.InvokeAsync<bool>("watch", _self, IsTitleBar);
        StateHasChanged();
        Settled?.Invoke();
    }

    [JSInvokable]
    public void SetDragRegions(double[] bar, double[][] holes, double devicePixelRatio) =>
        SpikeChrome.Current?.SetDragRegions(ToRect(bar), holes.Select(ToRect).ToArray(), devicePixelRatio);

    [JSInvokable]
    public async Task OnSchemeChanged(bool dark)
    {
        _systemDark = dark;
        _schemeChanges++;
        SpikeProbe.Mark("scheme-change", dark ? "dark" : "light");
        if (Environment.GetEnvironmentVariable("GFO_FIXED_MODE") == "1")
        {
            StateHasChanged();   // an explicit Dark/Light choice ignores Windows: does Fluent leave the theme alone?
            return;
        }

        await Theme.ApplyAsync(dark);
        SpikeProbe.Mark("scheme-reapplied", dark ? "dark" : "light");
        StateHasChanged();
    }

    private static System.Windows.Rect ToRect(double[] r) => new(r[0], r[1], r[2], r[3]);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The WebView is already gone at shutdown.
            }
        }

        _self?.Dispose();
    }
}
