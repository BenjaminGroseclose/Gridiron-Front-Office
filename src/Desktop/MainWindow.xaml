<Window x:Class="GridironFrontOffice.Desktop.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        Title="Gridiron Front Office"
        Width="1440" Height="900" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Spike S0c: Windows 11 style caption buttons (46 px wide, Segoe Fluent Icons). Tag = "hover"/"pressed" is set
             by the WM_NCHITTEST hook for the maximize button, which Windows owns while it answers HTMAXBUTTON. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource CaptionForeground}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionHover}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="hover">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionPressed}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="pressed">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B22A1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Option (a): the slim WPF caption strip. -->
        <Border x:Name="CaptionStrip" Grid.Row="0" Height="32" Background="{DynamicResource Ground}" Visibility="Collapsed">
            <TextBlock Text="Gridiron Front Office" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                       FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource CaptionMuted}" />
        </Border>

        <blazor:BlazorWebView x:Name="WebView" Grid.Row="1" HostPage="wwwroot\index.html" />

        <StackPanel x:Name="CaptionButtons" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
            <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize"
                    Click="OnMinimize" />
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize"
                    Click="OnMaximize" />
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close"
                    Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
