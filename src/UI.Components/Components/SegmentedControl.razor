@namespace GridironFrontOffice.UI.Components
@typeparam TValue
@implements IAsyncDisposable
@inject IJSRuntime JS
@* One choice from a few, as a pill of Fluent toggle buttons (UI_DESIGN_SYSTEM.md §5.2: v5 has none). It's a radio group
   for assistive technology: the chosen option is checked and is the only one in the Tab order, and Left/Right (and
   Home/End) move the choice, with focus following it. *@
<div @ref="_group" class="gfo-segmented @Class" role="radiogroup" aria-label="@Label" aria-disabled="@(Disabled ? "true" : null)"
     @onkeydown="OnKeyDownAsync" @attributes="AdditionalAttributes">
    @for (var i = 0; i < Options.Count; i++)
    {
        var index = i;
        var option = Options[index];
        var selected = IsSelected(option);
        <FluentToggleButton @key="option.Value" Pressed="@selected" Disabled="@Disabled" Shape="ButtonShape.Circular"
                            Appearance="@(selected ? ButtonAppearance.Primary : ButtonAppearance.Transparent)"
                            IconStart="@(option.Icon is { } icon ? IconCatalog.Create(icon, 20) : null)"
                            role="radio" aria-checked="@(selected ? "true" : "false")" tabindex="@(selected || (index == 0 && !Options.Any(IsSelected)) ? "0" : "-1")"
                            OnClick="@(() => SelectAsync(option))" data-value="@option.Value">@option.Label</FluentToggleButton>
    }
</div>

@code {
    private ElementReference _group;
    private IJSObjectReference? _dom;
    private bool _focusChecked;

    [Parameter, EditorRequired] public IReadOnlyList<SegmentedOption<TValue>> Options { get; set; } = [];

    [Parameter] public TValue? Value { get; set; }

    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>The group's accessible name, e.g. "Theme".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsSelected(SegmentedOption<TValue> option) => EqualityComparer<TValue>.Default.Equals(option.Value, Value);

    private async Task SelectAsync(SegmentedOption<TValue> option)
    {
        if (!IsSelected(option))
        {
            Value = option.Value;
            await ValueChanged.InvokeAsync(option.Value);
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Disabled || Options.Count == 0)
        {
            return;
        }

        var current = Math.Max(0, Options.ToList().FindIndex(IsSelected));
        var next = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => (current + 1) % Options.Count,
            "ArrowLeft" or "ArrowUp" => (current - 1 + Options.Count) % Options.Count,
            "Home" => 0,
            "End" => Options.Count - 1,
            _ => -1,
        };

        if (next >= 0 && next != current)
        {
            await SelectAsync(Options[next]);
            _focusChecked = true;   // focus follows the choice once the re-render has marked it checked
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusChecked)
        {
            _focusChecked = false;
            _dom ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GridironFrontOffice.UI.Components/gfo-dom.js");
            await _dom.InvokeVoidAsync("focusChecked", _group);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dom is not null)
        {
            try
            {
                await _dom.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is already gone.
            }
        }
    }
}
