@namespace GridironFrontOffice.UI.Components
@* What a screen shows when it has nothing yet: an icon, a short title, one line of help and an action. *@
<div class="gfo-empty @Class" @attributes="AdditionalAttributes">
    @if (Icon is { } icon)
    {
        <span class="gfo-empty-icon"><Icon Name="@icon" Size="24" /></span>
    }
    <p class="gfo-empty-title gfo-display">@Title</p>
    @if (ChildContent is not null)
    {
        <p class="gfo-empty-message">@ChildContent</p>
    }
    @if (Actions is not null)
    {
        <div class="gfo-empty-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public IconName? Icon { get; set; }

    /// <summary>The one line of help under the title.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Buttons, usually one primary action.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
